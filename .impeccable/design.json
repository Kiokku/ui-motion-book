  "narrative": {
    "northStar": "安静精密的设计实验室",
    "overview": "以长时间中文阅读和自主探索为中心。白色正文、浅蓝灰目录与准确的蓝色图形建立安静、精密、清楚的阅读空间；宋体标题保留书籍感，系统中文黑体与本地 Manrope 承担解释、控制与读数。\n\n实验解释一个明确概念，正文维持连续的阅读顺序。封面直接呈现可操作的缓动实验，读者通过比较、操作和即时反馈建立判断；15 类实验共用同一套浅色表面与语义颜色。",
    "keyCharacteristics": [
      "白色正文与浅蓝灰辅助区域。",
      "宋体层级、清晰正文、可核对的图形与读数。",
      "宽屏可收起目录、正文与实验、原文编辑器并列阅读。",
      "克制的阅读界面与可主动操作的实验。"
    ],
    "rules": [
      {
        "name": "The Semantic Color Rule",
        "body": "状态与实验角色必须同时提供文字、形状或读数，颜色用于辅助区分。",
        "section": "colors"
      },
      {
        "name": "The Computed Evidence Rule",
        "body": "曲线、当前位置与文字读数来自同一计算，视觉不能暗示与实际参数不同的进度。",
        "section": "components"
      }
    ],
    "dos": [
      "Do 保持正文可复制、可缩放，提供可见焦点与触屏可操作的控制。",
      "Do 用真实可操作的实验配合说明、边界与文字读数。",
      "Do 在所有章节、术语索引、复习与来源页复用浅色阅读系统。",
      "Do 把术语放在章节上下文中，并保留完整索引入口。"
    ],
    "donts": [
      "Don't 用重复卡片打断普通正文的阅读顺序。",
      "Don't 用持续循环的装饰运动争夺正文注意力。",
      "Don't 把浏览器教学模型表达为真实设备性能检测。",
      "Don't 在减少动态效果时移除实验的静态解释与结果。"
    ]
  }
}
